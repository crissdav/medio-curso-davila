{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/line.schema.json",
  "title": "LineDTO",
  "description": "Document line item. The request carries the input data; calculated amounts come back in the response (SPEC-003). UBL: cac:InvoiceLine / cac:CreditNoteLine / cac:DebitNoteLine.",
  "$defs": {
    "LineRequest": {
      "$ref": "#/$defs/LineBase",
      "unevaluatedProperties": false
    },
    "LineBase": {
      "type": "object",
      "required": ["description", "quantity", "unitOfMeasure", "unitValue", "igvAffectation"],
      "properties": {
        "productCode": { "type": "string", "pattern": "^[A-Z0-9-]{1,30}$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "quantity": { "$ref": "common.schema.json#/$defs/Quantity" },
        "unitOfMeasure": { "$ref": "common.schema.json#/$defs/UnitOfMeasure" },
        "unitValue": { "$ref": "common.schema.json#/$defs/UnitAmount", "description": "Before taxes. Must be 0 for free-of-charge operations (UBL cac:Price/cbc:PriceAmount = 0)." },
        "referenceUnitValue": { "$ref": "common.schema.json#/$defs/UnitAmount", "description": "Input for free-of-charge operations only: reference unit value, returned as unitPrice with catalog 16 code 02." },
        "igvAffectation": { "$ref": "common.schema.json#/$defs/IgvAffectation" },
        "discount": { "$ref": "common.schema.json#/$defs/Amount", "description": "Discount that reduces the line taxable base." },
        "isc": { "$ref": "product.schema.json#/$defs/IscConfig" },
        "icbperBagCount": { "type": "integer", "minimum": 1, "description": "Only if the item is a plastic bag." }
      },
      "if": {
        "required": ["igvAffectation"],
        "properties": { "igvAffectation": { "enum": ["11", "12", "13", "14", "15", "16", "21", "31", "32", "33", "34", "35", "36", "37"] } }
      },
      "then": {
        "required": ["referenceUnitValue"],
        "properties": { "unitValue": { "pattern": "^0+(\\.0+)?$" } }
      },
      "else": {
        "not": { "required": ["referenceUnitValue"] }
      }
    },
    "CalculatedLine": {
      "description": "Line with the amounts calculated by the domain.",
      "allOf": [
        { "$ref": "#/$defs/LineBase" },
        {
          "type": "object",
          "required": ["lineNumber", "unitPrice", "saleValue", "igvBase", "igv", "totalTaxes"],
          "properties": {
            "lineNumber": { "type": "integer", "minimum": 1 },
            "unitPrice": { "$ref": "common.schema.json#/$defs/UnitAmount", "description": "UBL PricingReference: price with taxes (catalog 16 code 01) or, for free-of-charge operations, the reference value (code 02)." },
            "saleValue": { "$ref": "common.schema.json#/$defs/Amount", "description": "quantity × unitValue − discount; for free-of-charge operations, quantity × referenceUnitValue." },
            "iscBase": { "$ref": "common.schema.json#/$defs/Amount" },
            "iscAmount": { "$ref": "common.schema.json#/$defs/Amount", "description": "Calculated according to catalog 08 (SPEC-003 R-02)." },
            "igvBase": { "$ref": "common.schema.json#/$defs/Amount", "description": "saleValue + iscAmount" },
            "igvRate": { "$ref": "common.schema.json#/$defs/Rate" },
            "igv": { "$ref": "common.schema.json#/$defs/Amount" },
            "icbper": { "$ref": "common.schema.json#/$defs/Amount" },
            "totalTaxes": { "$ref": "common.schema.json#/$defs/Amount" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/LineRequest"
}
