{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/producto.schema.json",
  "title": "ProductoDTO",
  "description": "Producto del catálogo de ABC con su configuración tributaria por defecto. SPEC-003, SPEC-010. UBL: cac:Item.",
  "type": "object",
  "required": ["codigo", "descripcion", "unidadMedida", "afectacionIgv", "valorUnitario"],
  "properties": {
    "codigo": { "type": "string", "pattern": "^[A-Z0-9-]{1,30}$", "description": "UBL: cac:SellersItemIdentification/cbc:ID" },
    "descripcion": { "type": "string", "minLength": 1, "maxLength": 500 },
    "codigoProductoSunat": { "type": "string", "pattern": "^[0-9]{8}$", "description": "UNSPSC (catálogo 25). UBL: cac:CommodityClassification/cbc:ItemClassificationCode" },
    "unidadMedida": { "$ref": "common.schema.json#/$defs/UnidadMedida" },
    "afectacionIgv": { "$ref": "common.schema.json#/$defs/AfectacionIgv" },
    "valorUnitario": { "$ref": "common.schema.json#/$defs/MontoUnitario", "description": "Sin impuestos." },
    "isc": { "$ref": "#/$defs/ConfiguracionIsc" },
    "afectoIcbper": { "type": "boolean", "default": false, "description": "true si el ítem es una bolsa plástica gravada con ICBPER." },
    "stockMinimo": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "activo": { "type": "boolean", "default": true },
    "requiereRevision": { "type": "boolean", "default": false, "description": "true si la configuración tributaria es provisional (producto creado por migración, SPEC-009 M-04)." },
    "origen": { "$ref": "common.schema.json#/$defs/OrigenDato" }
  },
  "$defs": {
    "ConfiguracionIsc": {
      "description": "Configuración del ISC según catálogo 08.",
      "type": "object",
      "required": ["sistema"],
      "properties": {
        "sistema": { "$ref": "common.schema.json#/$defs/SistemaIsc" },
        "tasa": { "$ref": "common.schema.json#/$defs/Tasa" },
        "montoFijo": { "$ref": "common.schema.json#/$defs/MontoUnitario" },
        "precioVentaPublico": { "$ref": "common.schema.json#/$defs/MontoUnitario" }
      },
      "allOf": [
        { "if": { "properties": { "sistema": { "const": "01" } } }, "then": { "required": ["tasa"] } },
        { "if": { "properties": { "sistema": { "const": "02" } } }, "then": { "required": ["montoFijo"] } },
        { "if": { "properties": { "sistema": { "const": "03" } } }, "then": { "required": ["tasa", "precioVentaPublico"] } }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
