{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/nota.schema.json",
  "title": "NotaDTO (Crédito / Débito)",
  "description": "Emisión de Nota de Crédito (07, UBL CreditNote) y Nota de Débito (08, UBL DebitNote). SPEC-002.",
  "type": "object",
  "required": ["tipoComprobante", "serie", "fechaEmision", "documentoAfectado", "tipoNota", "motivo", "moneda", "items"],
  "properties": {
    "tipoComprobante": { "type": "string", "enum": ["07", "08"] },
    "serie": { "$ref": "common.schema.json#/$defs/Serie" },
    "fechaEmision": { "$ref": "common.schema.json#/$defs/Fecha" },
    "documentoAfectado": {
      "description": "UBL: cac:BillingReference/cac:InvoiceDocumentReference.",
      "type": "object",
      "required": ["tipoComprobante", "numero"],
      "properties": {
        "tipoComprobante": { "type": "string", "enum": ["01", "03"] },
        "numero": { "$ref": "common.schema.json#/$defs/NumeroComprobante" }
      },
      "additionalProperties": false
    },
    "tipoNota": { "type": "string", "pattern": "^[0-9]{2}$", "description": "Catálogo 09 (crédito) o 10 (débito). UBL: cac:DiscrepancyResponse/cbc:ResponseCode." },
    "motivo": { "type": "string", "minLength": 1, "maxLength": 250, "description": "UBL: cac:DiscrepancyResponse/cbc:Description." },
    "moneda": { "$ref": "common.schema.json#/$defs/Moneda" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "linea.schema.json#/$defs/LineaSolicitud" } }
  },
  "allOf": [
    {
      "if": { "properties": { "tipoComprobante": { "const": "07" } } },
      "then": { "properties": { "tipoNota": { "enum": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12", "13"] } } }
    },
    {
      "if": { "properties": { "tipoComprobante": { "const": "08" } } },
      "then": { "properties": { "tipoNota": { "enum": ["01", "02", "03", "11", "12"] } } }
    }
  ],
  "additionalProperties": false
}
