{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/note.schema.json",
  "title": "NoteDTO (Credit / Debit note)",
  "description": "Issuance of a Credit Note (07, UBL CreditNote) or a Debit Note (08, UBL DebitNote). SPEC-002.",
  "type": "object",
  "required": ["documentType", "series", "issueDate", "affectedDocument", "noteType", "reason", "currency", "items"],
  "properties": {
    "documentType": { "type": "string", "enum": ["07", "08"] },
    "series": { "$ref": "common.schema.json#/$defs/Series" },
    "issueDate": { "$ref": "common.schema.json#/$defs/Date" },
    "affectedDocument": {
      "description": "UBL: cac:BillingReference/cac:InvoiceDocumentReference.",
      "type": "object",
      "required": ["documentType", "number"],
      "properties": {
        "documentType": { "type": "string", "enum": ["01", "03"] },
        "number": { "$ref": "common.schema.json#/$defs/DocumentNumber" }
      },
      "additionalProperties": false
    },
    "noteType": { "type": "string", "pattern": "^[0-9]{2}$", "description": "Catalog 09 (credit) or 10 (debit). UBL: cac:DiscrepancyResponse/cbc:ResponseCode." },
    "reason": { "type": "string", "minLength": 1, "maxLength": 250, "description": "UBL: cac:DiscrepancyResponse/cbc:Description." },
    "currency": { "$ref": "common.schema.json#/$defs/Currency" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "line.schema.json#/$defs/LineRequest" } }
  },
  "allOf": [
    {
      "if": { "properties": { "documentType": { "const": "07" } } },
      "then": { "properties": { "noteType": { "enum": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12", "13"] } } }
    },
    {
      "if": { "properties": { "documentType": { "const": "08" } } },
      "then": { "properties": { "noteType": { "enum": ["01", "02", "03", "11", "12"] } } }
    }
  ],
  "additionalProperties": false
}
