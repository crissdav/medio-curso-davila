{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/catalogo.schema.json",
  "title": "CatalogoSunatDTO",
  "description": "Estructura de los archivos en specs/catalogos/ y de la respuesta GET /catalogos/{numero}. SPEC-011.",
  "type": "object",
  "required": ["numero", "nombre", "codigos"],
  "properties": {
    "numero": { "type": "string", "pattern": "^[0-9]{2}$" },
    "nombre": { "type": "string" },
    "listAgencyName": { "type": "string" },
    "listID": { "type": "string" },
    "listURI": { "type": "string" },
    "schemeURI": { "type": "string" },
    "ublXPath": { "type": "string" },
    "codigos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["codigo", "descripcion"],
        "properties": {
          "codigo": { "type": "string" },
          "descripcion": { "type": "string" },
          "fase": { "type": "integer", "description": "Si existe, el código queda fuera del alcance de la fase 1." }
        }
      }
    }
  }
}
