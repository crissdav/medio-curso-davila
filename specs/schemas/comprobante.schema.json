{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/comprobante.schema.json",
  "title": "ComprobanteDTO (Factura / Boleta)",
  "description": "Contratos de emisión de Factura (01) y Boleta (03). SPEC-001. UBL raíz: Invoice (UBL-Invoice-2.1.xsd).",
  "$defs": {
    "FormaPago": {
      "description": "UBL: cac:PaymentTerms[cbc:ID='FormaPago'].",
      "type": "object",
      "required": ["tipo"],
      "properties": {
        "tipo": { "type": "string", "enum": ["Contado", "Credito"] },
        "montoPendiente": { "$ref": "common.schema.json#/$defs/Monto" },
        "cuotas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["monto", "fechaVencimiento"],
            "properties": {
              "monto": { "$ref": "common.schema.json#/$defs/Monto" },
              "fechaVencimiento": { "$ref": "common.schema.json#/$defs/Fecha" }
            },
            "additionalProperties": false
          }
        }
      },
      "if": { "properties": { "tipo": { "const": "Credito" } } },
      "then": { "required": ["montoPendiente", "cuotas"] },
      "additionalProperties": false
    },
    "EmitirComprobanteRequest": {
      "type": "object",
      "required": ["tipoComprobante", "serie", "tipoOperacion", "fechaEmision", "moneda", "cliente", "items", "formaPago"],
      "properties": {
        "tipoComprobante": { "type": "string", "enum": ["01", "03"] },
        "serie": { "$ref": "common.schema.json#/$defs/Serie" },
        "tipoOperacion": { "$ref": "common.schema.json#/$defs/TipoOperacion" },
        "fechaEmision": { "$ref": "common.schema.json#/$defs/Fecha" },
        "horaEmision": { "$ref": "common.schema.json#/$defs/Hora" },
        "fechaVencimiento": { "$ref": "common.schema.json#/$defs/Fecha" },
        "moneda": { "$ref": "common.schema.json#/$defs/Moneda" },
        "tipoCambio": { "type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,3}$" },
        "cliente": { "$ref": "cliente.schema.json" },
        "items": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "linea.schema.json#/$defs/LineaSolicitud" } },
        "descuentoGlobal": { "$ref": "common.schema.json#/$defs/Monto" },
        "formaPago": { "$ref": "#/$defs/FormaPago" },
        "observaciones": { "type": "string", "maxLength": 500 },
        "establecimiento": { "type": "string", "pattern": "^[0-9]{4}$", "default": "0000", "description": "Código de establecimiento anexo SUNAT." }
      },
      "allOf": [
        {
          "if": { "properties": { "tipoComprobante": { "const": "01" } } },
          "then": {
            "properties": {
              "serie": { "pattern": "^F" },
              "cliente": { "properties": { "tipoDocumento": { "const": "6" } } }
            }
          }
        },
        {
          "if": { "properties": { "tipoComprobante": { "const": "03" } } },
          "then": { "properties": { "serie": { "pattern": "^B" } } }
        },
        {
          "if": { "properties": { "moneda": { "not": { "const": "PEN" } } } },
          "then": { "required": ["tipoCambio"] }
        }
      ],
      "additionalProperties": false
    },
    "Totales": {
      "description": "UBL: cac:TaxTotal y cac:LegalMonetaryTotal.",
      "type": "object",
      "required": ["totalGravadas", "totalExoneradas", "totalInafectas", "totalGratuitas", "totalIsc", "totalIgv", "totalIcbper", "totalImpuestos", "totalValorVenta", "totalPrecioVenta", "totalDescuentos", "importeTotal"],
      "properties": {
        "totalGravadas": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalExoneradas": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalInafectas": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalExportacion": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalGratuitas": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalIsc": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalIgv": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalIcbper": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalImpuestos": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalValorVenta": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalPrecioVenta": { "$ref": "common.schema.json#/$defs/Monto" },
        "totalDescuentos": { "$ref": "common.schema.json#/$defs/Monto" },
        "redondeo": { "$ref": "common.schema.json#/$defs/Monto" },
        "importeTotal": { "$ref": "common.schema.json#/$defs/Monto" },
        "importeEnLetras": { "type": "string", "description": "UBL: cbc:Note[@languageLocaleID='1000'] (catálogo 52)." }
      },
      "additionalProperties": false
    },
    "Comprobante": {
      "description": "Respuesta: comprobante emitido con importes calculados, estado y enlaces.",
      "type": "object",
      "required": ["id", "tipoComprobante", "serie", "correlativo", "numero", "fechaEmision", "moneda", "emisor", "cliente", "items", "totales", "estado"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "tipoComprobante": { "$ref": "common.schema.json#/$defs/TipoComprobante" },
        "serie": { "$ref": "common.schema.json#/$defs/Serie" },
        "correlativo": { "$ref": "common.schema.json#/$defs/Correlativo" },
        "numero": { "$ref": "common.schema.json#/$defs/NumeroComprobante" },
        "tipoOperacion": { "$ref": "common.schema.json#/$defs/TipoOperacion" },
        "fechaEmision": { "$ref": "common.schema.json#/$defs/Fecha" },
        "horaEmision": { "$ref": "common.schema.json#/$defs/Hora" },
        "moneda": { "$ref": "common.schema.json#/$defs/Moneda" },
        "emisor": {
          "type": "object",
          "required": ["ruc", "razonSocial"],
          "properties": {
            "ruc": { "$ref": "common.schema.json#/$defs/Ruc" },
            "razonSocial": { "type": "string" },
            "nombreComercial": { "type": "string" },
            "establecimiento": { "type": "string", "pattern": "^[0-9]{4}$" }
          }
        },
        "cliente": { "$ref": "cliente.schema.json" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "linea.schema.json#/$defs/LineaCalculada" } },
        "formaPago": { "$ref": "#/$defs/FormaPago" },
        "totales": { "$ref": "#/$defs/Totales" },
        "estado": { "$ref": "common.schema.json#/$defs/EstadoComprobante" },
        "hashCpe": { "type": "string", "description": "DigestValue de la firma (se imprime en la representación impresa)." },
        "cdr": { "$ref": "respuesta-cdr.schema.json" },
        "enlaces": {
          "type": "object",
          "properties": {
            "xml": { "type": "string", "format": "uri-reference" },
            "cdr": { "type": "string", "format": "uri-reference" },
            "pdf": { "type": "string", "format": "uri-reference" }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/EmitirComprobanteRequest"
}
