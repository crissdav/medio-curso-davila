{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/common.schema.json",
  "title": "Tipos comunes",
  "description": "Tipos primitivos del dominio reutilizados por todos los contratos. Los montos se transportan como string decimal para evitar errores de redondeo de punto flotante.",
  "$defs": {
    "Monto": {
      "description": "Importe con 2 decimales (totales). UBL: atributo currencyID en el elemento.",
      "type": "string",
      "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
      "examples": ["118.00"]
    },
    "MontoUnitario": {
      "description": "Valor o precio unitario con hasta 10 decimales (SUNAT admite 10 en unitarios).",
      "type": "string",
      "pattern": "^[0-9]{1,12}(\\.[0-9]{1,10})?$",
      "examples": ["3.3898305085"]
    },
    "Cantidad": {
      "description": "Cantidad con hasta 10 decimales, mayor que cero.",
      "type": "string",
      "pattern": "^(?!0+(\\.0+)?$)[0-9]{1,12}(\\.[0-9]{1,10})?$",
      "examples": ["12", "2.5"]
    },
    "Tasa": {
      "description": "Tasa expresada como fracción (0.18 = 18 %).",
      "type": "string",
      "pattern": "^0?(\\.[0-9]{1,6})?$|^1(\\.0+)?$",
      "examples": ["0.18"]
    },
    "Fecha": { "type": "string", "format": "date", "examples": ["2026-10-22"] },
    "Hora": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "examples": ["10:15:00"] },
    "Ruc": {
      "description": "RUC de 11 dígitos. Además del patrón, el dominio valida dígito verificador módulo 11 (SPEC-004).",
      "type": "string",
      "pattern": "^(10|15|16|17|20)[0-9]{9}$",
      "examples": ["20123456786"]
    },
    "TipoComprobante": {
      "description": "Catálogo 01.",
      "type": "string",
      "enum": ["01", "03", "07", "08"]
    },
    "TipoDocumentoIdentidad": {
      "description": "Catálogo 06.",
      "type": "string",
      "enum": ["0", "1", "4", "6", "7", "A", "-"]
    },
    "Moneda": {
      "description": "Catálogo 02 (ISO 4217).",
      "type": "string",
      "enum": ["PEN", "USD", "EUR"]
    },
    "UnidadMedida": {
      "description": "Catálogo 03 (UN/ECE Rec 20).",
      "type": "string",
      "enum": ["NIU", "ZZ", "KGM", "GRM", "LTR", "MLT", "BX", "BG", "PK", "DZN"]
    },
    "AfectacionIgv": {
      "description": "Catálogo 07.",
      "type": "string",
      "enum": ["10", "11", "12", "13", "14", "15", "16", "17", "20", "21", "30", "31", "32", "33", "34", "35", "36", "37", "40"]
    },
    "SistemaIsc": {
      "description": "Catálogo 08: 01 al valor, 02 monto fijo, 03 precio de venta al público.",
      "type": "string",
      "enum": ["01", "02", "03"]
    },
    "TipoOperacion": {
      "description": "Catálogo 51.",
      "type": "string",
      "enum": ["0101", "0200", "1001"]
    },
    "Serie": {
      "description": "4 caracteres: F### facturas y sus notas, B### boletas y sus notas.",
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}$",
      "examples": ["F001", "B001"]
    },
    "Correlativo": { "type": "integer", "minimum": 1, "maximum": 99999999 },
    "NumeroComprobante": {
      "description": "Serie-correlativo.",
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}-[0-9]{1,8}$",
      "examples": ["F001-00000123"]
    },
    "EstadoComprobante": {
      "type": "string",
      "enum": ["BORRADOR", "FIRMADO", "PENDIENTE_ENVIO", "ENVIADO", "ACEPTADO", "OBSERVADO", "RECHAZADO", "ANULADO"]
    },
    "OrigenDato": {
      "description": "Trazabilidad del origen del registro (RS 234-2006).",
      "type": "object",
      "required": ["sistema"],
      "properties": {
        "sistema": { "type": "string", "enum": ["NUEVO", "LEGADO"] },
        "loteMigracion": { "type": "string" },
        "filaOrigen": { "type": "integer", "minimum": 1 },
        "hashOrigen": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 de la fila legado original." }
      },
      "additionalProperties": false
    }
  }
}
