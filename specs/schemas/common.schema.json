{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/common.schema.json",
  "title": "Common types",
  "description": "Domain primitive types reused by every contract. Amounts travel as decimal strings to avoid floating-point rounding errors.",
  "$defs": {
    "Amount": {
      "description": "Amount with 2 decimals (totals). UBL: currencyID attribute on the element.",
      "type": "string",
      "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
      "examples": ["118.00"]
    },
    "UnitAmount": {
      "description": "Unit value or price with up to 10 decimals (SUNAT accepts 10 for unit amounts).",
      "type": "string",
      "pattern": "^[0-9]{1,12}(\\.[0-9]{1,10})?$",
      "examples": ["3.3898305085"]
    },
    "Quantity": {
      "description": "Quantity with up to 10 decimals, greater than zero.",
      "type": "string",
      "pattern": "^(?!0+(\\.0+)?$)[0-9]{1,12}(\\.[0-9]{1,10})?$",
      "examples": ["12", "2.5"]
    },
    "Rate": {
      "description": "Rate expressed as a fraction (0.18 = 18 %).",
      "type": "string",
      "pattern": "^0?(\\.[0-9]{1,6})?$|^1(\\.0+)?$",
      "examples": ["0.18"]
    },
    "Date": { "type": "string", "format": "date", "examples": ["2026-10-22"] },
    "Time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$", "examples": ["10:15:00"] },
    "Ruc": {
      "description": "11-digit RUC (Peruvian taxpayer ID). Besides the pattern, the domain validates the modulus 11 check digit (SPEC-004).",
      "type": "string",
      "pattern": "^(10|15|16|17|20)[0-9]{9}$",
      "examples": ["20123456786"]
    },
    "DocumentType": {
      "description": "Catalog 01.",
      "type": "string",
      "enum": ["01", "03", "07", "08"]
    },
    "IdentityDocumentType": {
      "description": "Catalog 06.",
      "type": "string",
      "enum": ["0", "1", "4", "6", "7", "A", "-"]
    },
    "Currency": {
      "description": "Catalog 02 (ISO 4217).",
      "type": "string",
      "enum": ["PEN", "USD", "EUR"]
    },
    "UnitOfMeasure": {
      "description": "Catalog 03 (UN/ECE Rec 20).",
      "type": "string",
      "enum": ["NIU", "ZZ", "KGM", "GRM", "LTR", "MLT", "BX", "BG", "PK", "DZN"]
    },
    "IgvAffectation": {
      "description": "Catalog 07.",
      "type": "string",
      "enum": ["10", "11", "12", "13", "14", "15", "16", "17", "20", "21", "30", "31", "32", "33", "34", "35", "36", "37", "40"]
    },
    "IscSystem": {
      "description": "Catalog 08: 01 ad valorem, 02 fixed amount, 03 retail price.",
      "type": "string",
      "enum": ["01", "02", "03"]
    },
    "OperationType": {
      "description": "Catalog 51.",
      "type": "string",
      "enum": ["0101", "0200", "1001"]
    },
    "Series": {
      "description": "4 characters: F### for invoices and their notes, B### for sales receipts and their notes.",
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}$",
      "examples": ["F001", "B001"]
    },
    "SequenceNumber": { "type": "integer", "minimum": 1, "maximum": 99999999 },
    "DocumentNumber": {
      "description": "Series-sequence number.",
      "type": "string",
      "pattern": "^[FB][A-Z0-9]{3}-[0-9]{1,8}$",
      "examples": ["F001-00000123"]
    },
    "DocumentStatus": {
      "type": "string",
      "enum": ["DRAFT", "SIGNED", "PENDING_SUBMISSION", "SUBMITTED", "ACCEPTED", "OBSERVED", "REJECTED", "VOIDED"]
    },
    "DataOrigin": {
      "description": "Traceability of the record origin (RS 234-2006).",
      "type": "object",
      "required": ["system"],
      "properties": {
        "system": { "type": "string", "enum": ["NEW", "LEGACY"] },
        "migrationBatch": { "type": "string" },
        "sourceRow": { "type": "integer", "minimum": 1 },
        "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the original legacy row." }
      },
      "additionalProperties": false
    }
  }
}
