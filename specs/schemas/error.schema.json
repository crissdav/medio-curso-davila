{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/error.schema.json",
  "title": "ErrorDTO (RFC 9457 problem+json)",
  "description": "Single error format for the whole API.",
  "type": "object",
  "required": ["type", "title", "status", "code"],
  "properties": {
    "type": { "type": "string", "format": "uri-reference" },
    "title": { "type": "string" },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "detail": { "type": "string" },
    "code": {
      "type": "string",
      "description": "Internal business code (e.g. INVALID_RUC, TOTALS_MISMATCH, SERIES_NOT_AUTHORIZED) or SUNAT code with the SUNAT- prefix (e.g. SUNAT-2800).",
      "pattern": "^([A-Z_]+|SUNAT-[0-9]{4})$"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string", "description": "JSON Pointer of the field, e.g. /items/0/quantity" },
          "message": { "type": "string" },
          "rule": { "type": "string", "description": "Spec rule ID, e.g. SPEC-003/R-04" }
        }
      }
    }
  }
}
