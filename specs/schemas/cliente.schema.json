{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/cliente.schema.json",
  "title": "ClienteDTO",
  "description": "Adquiriente o usuario del comprobante. SPEC-004. UBL: cac:AccountingCustomerParty.",
  "type": "object",
  "required": ["tipoDocumento", "numeroDocumento", "razonSocial"],
  "properties": {
    "tipoDocumento": { "$ref": "common.schema.json#/$defs/TipoDocumentoIdentidad" },
    "numeroDocumento": { "type": "string", "maxLength": 15 },
    "razonSocial": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "direccion": { "type": "string", "maxLength": 200 },
    "ubigeo": { "type": "string", "pattern": "^[0-9]{6}$" },
    "correo": { "type": "string", "format": "email" }
  },
  "allOf": [
    {
      "if": { "properties": { "tipoDocumento": { "const": "6" } } },
      "then": { "properties": { "numeroDocumento": { "$ref": "common.schema.json#/$defs/Ruc" } } }
    },
    {
      "if": { "properties": { "tipoDocumento": { "const": "1" } } },
      "then": { "properties": { "numeroDocumento": { "pattern": "^[0-9]{8}$" } } }
    }
  ],
  "additionalProperties": false
}
