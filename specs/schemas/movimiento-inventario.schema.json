{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/movimiento-inventario.schema.json",
  "title": "MovimientoInventarioDTO",
  "description": "Movimiento de almacén del nuevo sistema. Destino de la migración (SPEC-009) y generado automáticamente al emitir comprobantes (SPEC-010).",
  "type": "object",
  "required": ["id", "fecha", "tipo", "codigoProducto", "cantidad", "documentoReferencia", "origen"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "fecha": { "$ref": "common.schema.json#/$defs/Fecha" },
    "tipo": { "type": "string", "enum": ["INGRESO", "SALIDA", "AJUSTE"] },
    "codigoProducto": { "type": "string", "pattern": "^[A-Z0-9-]{1,30}$" },
    "cantidad": { "$ref": "common.schema.json#/$defs/Cantidad" },
    "documentoReferencia": {
      "type": "object",
      "required": ["tipo", "numero"],
      "properties": {
        "tipo": { "type": "string", "enum": ["INTERNO_LEGADO", "COMPROBANTE", "GUIA", "AJUSTE"] },
        "numero": { "type": "string", "maxLength": 30 },
        "comprobanteId": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": false
    },
    "origen": { "$ref": "common.schema.json#/$defs/OrigenDato" }
  },
  "additionalProperties": false
}
