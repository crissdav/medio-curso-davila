{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/customer.schema.json",
  "title": "CustomerDTO",
  "description": "Buyer of the document. SPEC-004. UBL: cac:AccountingCustomerParty.",
  "type": "object",
  "required": ["documentType", "documentNumber", "legalName"],
  "properties": {
    "documentType": { "$ref": "common.schema.json#/$defs/IdentityDocumentType" },
    "documentNumber": { "type": "string", "maxLength": 15 },
    "legalName": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "address": { "type": "string", "maxLength": 200 },
    "ubigeo": { "type": "string", "pattern": "^[0-9]{6}$", "description": "Peruvian district code (INEI)." },
    "email": { "type": "string", "format": "email" }
  },
  "allOf": [
    {
      "if": { "properties": { "documentType": { "const": "6" } } },
      "then": { "properties": { "documentNumber": { "$ref": "common.schema.json#/$defs/Ruc" } } }
    },
    {
      "if": { "properties": { "documentType": { "const": "1" } } },
      "then": { "properties": { "documentNumber": { "pattern": "^[0-9]{8}$" } } }
    }
  ],
  "additionalProperties": false
}
