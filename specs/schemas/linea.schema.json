{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/linea.schema.json",
  "title": "LineaDTO",
  "description": "Ítem de un comprobante. La solicitud trae los datos de entrada; los importes calculados se devuelven en la respuesta (SPEC-003). UBL: cac:InvoiceLine / cac:CreditNoteLine / cac:DebitNoteLine.",
  "$defs": {
    "LineaSolicitud": {
      "$ref": "#/$defs/LineaBase",
      "unevaluatedProperties": false
    },
    "LineaBase": {
      "type": "object",
      "required": ["descripcion", "cantidad", "unidadMedida", "valorUnitario", "afectacionIgv"],
      "properties": {
        "codigoProducto": { "type": "string", "pattern": "^[A-Z0-9-]{1,30}$" },
        "descripcion": { "type": "string", "minLength": 1, "maxLength": 500 },
        "cantidad": { "$ref": "common.schema.json#/$defs/Cantidad" },
        "unidadMedida": { "$ref": "common.schema.json#/$defs/UnidadMedida" },
        "valorUnitario": { "$ref": "common.schema.json#/$defs/MontoUnitario", "description": "Sin impuestos. En operaciones gratuitas es el valor referencial." },
        "afectacionIgv": { "$ref": "common.schema.json#/$defs/AfectacionIgv" },
        "descuento": { "$ref": "common.schema.json#/$defs/Monto", "description": "Descuento que afecta la base imponible del ítem." },
        "isc": { "$ref": "producto.schema.json#/$defs/ConfiguracionIsc" },
        "cantidadBolsasIcbper": { "type": "integer", "minimum": 1, "description": "Solo si el ítem es bolsa plástica." }
      }
    },
    "LineaCalculada": {
      "description": "Línea con importes calculados por el dominio.",
      "allOf": [
        { "$ref": "#/$defs/LineaBase" },
        {
          "type": "object",
          "required": ["numeroLinea", "precioUnitario", "valorVenta", "baseIgv", "igv", "totalImpuestos"],
          "properties": {
            "numeroLinea": { "type": "integer", "minimum": 1 },
            "precioUnitario": { "$ref": "common.schema.json#/$defs/MontoUnitario", "description": "Con impuestos (catálogo 16 código 01) o referencial (código 02)." },
            "valorVenta": { "$ref": "common.schema.json#/$defs/Monto", "description": "cantidad × valorUnitario − descuento" },
            "baseIsc": { "$ref": "common.schema.json#/$defs/Monto" },
            "montoIsc": { "$ref": "common.schema.json#/$defs/Monto", "description": "Calculado según catálogo 08." },
            "baseIgv": { "$ref": "common.schema.json#/$defs/Monto", "description": "valorVenta + montoIsc" },
            "tasaIgv": { "$ref": "common.schema.json#/$defs/Tasa" },
            "igv": { "$ref": "common.schema.json#/$defs/Monto" },
            "icbper": { "$ref": "common.schema.json#/$defs/Monto" },
            "totalImpuestos": { "$ref": "common.schema.json#/$defs/Monto" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/LineaSolicitud"
}
