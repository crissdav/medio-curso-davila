{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc-software.pe/specs/schemas/invoice.schema.json",
  "title": "InvoiceDTO (Invoice / Sales receipt)",
  "description": "Issuance contracts for the Invoice (01, factura) and the Sales receipt (03, boleta). SPEC-001. UBL root: Invoice (UBL-Invoice-2.1.xsd).",
  "$defs": {
    "PaymentTerms": {
      "description": "UBL: cac:PaymentTerms[cbc:ID='FormaPago'] (RS 000193-2020/SUNAT). The values Contado / Credito are the literal SUNAT values.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Contado",
            "Credito"
          ],
          "description": "Contado = cash, Credito = credit."
        },
        "pendingAmount": {
          "$ref": "common.schema.json#/$defs/Amount"
        },
        "installments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "amount",
              "dueDate"
            ],
            "properties": {
              "amount": {
                "$ref": "common.schema.json#/$defs/Amount"
              },
              "dueDate": {
                "$ref": "common.schema.json#/$defs/Date"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "Credito"
          }
        }
      },
      "then": {
        "required": [
          "pendingAmount",
          "installments"
        ]
      },
      "additionalProperties": false
    },
    "IssueInvoiceRequest": {
      "type": "object",
      "required": [
        "documentType",
        "series",
        "operationType",
        "issueDate",
        "currency",
        "customer",
        "items",
        "paymentTerms"
      ],
      "properties": {
        "documentType": {
          "type": "string",
          "enum": [
            "01",
            "03"
          ]
        },
        "series": {
          "$ref": "common.schema.json#/$defs/Series"
        },
        "operationType": {
          "$ref": "common.schema.json#/$defs/OperationType"
        },
        "issueDate": {
          "$ref": "common.schema.json#/$defs/Date"
        },
        "issueTime": {
          "$ref": "common.schema.json#/$defs/Time"
        },
        "dueDate": {
          "$ref": "common.schema.json#/$defs/Date"
        },
        "currency": {
          "$ref": "common.schema.json#/$defs/Currency"
        },
        "exchangeRate": {
          "type": "string",
          "pattern": "^[0-9]{1,4}\\.[0-9]{1,3}$"
        },
        "customer": {
          "$ref": "customer.schema.json"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "line.schema.json#/$defs/LineRequest"
          }
        },
        "globalDiscount": {
          "$ref": "common.schema.json#/$defs/Amount"
        },
        "paymentTerms": {
          "$ref": "#/$defs/PaymentTerms"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "establishment": {
          "type": "string",
          "pattern": "^[0-9]{4}$",
          "default": "0000",
          "description": "SUNAT annex establishment code."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "documentType": {
                "const": "01"
              }
            }
          },
          "then": {
            "properties": {
              "series": {
                "pattern": "^F"
              },
              "customer": {
                "properties": {
                  "documentType": {
                    "const": "6"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "documentType": {
                "const": "03"
              }
            }
          },
          "then": {
            "properties": {
              "series": {
                "pattern": "^B"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "currency": {
                "not": {
                  "const": "PEN"
                }
              }
            }
          },
          "then": {
            "required": [
              "exchangeRate"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "Invoice": {
      "description": "Response: issued invoice or sales receipt with calculated amounts, status and links.",
      "allOf": [
        {
          "$ref": "sales-document.schema.json#/$defs/SalesDocument"
        },
        {
          "type": "object",
          "properties": {
            "documentType": {
              "type": "string",
              "enum": [
                "01",
                "03"
              ]
            },
            "operationType": {
              "$ref": "common.schema.json#/$defs/OperationType"
            },
            "paymentTerms": {
              "$ref": "#/$defs/PaymentTerms"
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/IssueInvoiceRequest"
}
