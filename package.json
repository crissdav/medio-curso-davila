{
  "name": "abc-facturacion-specs",
  "version": "0.1.0",
  "private": true,
  "description": "Especificaciones Spec-First del sistema de facturación electrónica de ABC Software Corp.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate.mjs && npm run lint:api",
    "validate:specs": "node scripts/validate.mjs",
    "lint:api": "redocly lint specs/api/openapi.yaml --config redocly.yaml",
    "check:mermaid": "node scripts/check-mermaid.mjs",
    "check:xsd": "java -Dstdout.encoding=UTF-8 scripts/ValidarXsd.java"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.3",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
